<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Flowchart Mastermind First Success"/>
        <attribute name="authors" value="matth"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-09 03:51:53 "/>
        <attribute name="created" value="bWF0dGg7TEFQVE9QX01BVFRISUFTOzIwMjYtMTAtMDI7IjAyOjU0OjE1ICI7Mjg4OQ=="/>
        <attribute name="edited" value="bWF0dGg7TEFQVE9QX01BVFRISUFTOzIwMjYtMTAtMDk7IjAzOjUxOjUzICI7NTszMDA4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="zwartepin, wittepin, rij" type="Integer" array="False" size=""/>
            <declare name="code" type="String" array="False" size=""/>
            <declare name="pogingen" type="String" array="True" size="4"/>
            <declare name="codevakjes" type="String" array="True" size="4"/>
            <assign variable="codevakjes[0]" expression="&quot;rood&quot;"/>
            <assign variable="codevakjes[1]" expression="&quot;blauw&quot;"/>
            <assign variable="codevakjes[2]" expression="&quot;paars&quot;"/>
            <assign variable="codevakjes[3]" expression="&quot;oranje&quot;"/>
            <assign variable="code" expression="codevakjes[0] &amp; &quot; &quot; &amp; codevakjes[1] &amp; &quot; &quot; &amp; codevakjes[2] &amp; &quot; &quot; &amp; codevakjes[3]"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="rij" expression="0"/>
            <assign variable="zwartepin" expression="0"/>
            <assign variable="wittepin" expression="0"/>
            <for variable="rij" start="0" end="9" direction="inc" step="1">
                <assign variable="zwartepin" expression="0"/>
                <assign variable="wittepin" expression="0"/>
                <for variable="i" start="0" end="3" direction="inc" step="1">
                    <output expression="&quot;codevakje &quot; &amp; i + 1" newline="True"/>
                    <input variable="pogingen[i]"/>
                </for>
                <if expression="codevakjes[0] = pogingen[0]">
                    <then>
                        <assign variable="zwartepin" expression="zwartepin+1"/>
                    </then>
                    <else>
                        <if expression="codevakjes[1] = pogingen[0]">
                            <then>
                                <assign variable="wittepin" expression="wittepin+1"/>
                            </then>
                            <else>
                                <if expression="codevakjes[2] = pogingen[0]">
                                    <then>
                                        <assign variable="wittepin" expression="wittepin+1"/>
                                    </then>
                                    <else>
                                        <if expression="codevakjes[3] = pogingen[0]">
                                            <then>
                                                <assign variable="wittepin" expression="wittepin+1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <if expression="codevakjes[1] = pogingen[1]">
                    <then>
                        <assign variable="zwartepin" expression="zwartepin+1"/>
                    </then>
                    <else>
                        <if expression="codevakjes[0] = pogingen[1]">
                            <then>
                                <assign variable="wittepin" expression="wittepin+1"/>
                            </then>
                            <else>
                                <if expression="codevakjes[2] = pogingen[1]">
                                    <then>
                                        <assign variable="wittepin" expression="wittepin+1"/>
                                    </then>
                                    <else>
                                        <if expression="codevakjes[3] = pogingen[1]">
                                            <then>
                                                <assign variable="wittepin" expression="wittepin+1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <if expression="codevakjes[2] = pogingen[2]">
                    <then>
                        <assign variable="zwartepin" expression="zwartepin+1"/>
                    </then>
                    <else>
                        <if expression="codevakjes[0] = pogingen[2]">
                            <then>
                                <assign variable="wittepin" expression="wittepin+1"/>
                            </then>
                            <else>
                                <if expression="codevakjes[1] = pogingen[2]">
                                    <then>
                                        <assign variable="wittepin" expression="wittepin+1"/>
                                    </then>
                                    <else>
                                        <if expression="codevakjes[3] = pogingen[2]">
                                            <then>
                                                <assign variable="wittepin" expression="wittepin+1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <if expression="codevakjes[3] = pogingen[3]">
                    <then>
                        <assign variable="zwartepin" expression="zwartepin+1"/>
                    </then>
                    <else>
                        <if expression="codevakjes[0] = pogingen[3]">
                            <then>
                                <assign variable="wittepin" expression="wittepin+1"/>
                            </then>
                            <else>
                                <if expression="codevakjes[1] = pogingen[3]">
                                    <then>
                                        <assign variable="wittepin" expression="wittepin+1"/>
                                    </then>
                                    <else>
                                        <if expression="codevakjes[2] = pogingen[3]">
                                            <then>
                                                <assign variable="wittepin" expression="wittepin+1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <output expression="&quot;Je hebt &quot; &amp; zwartepin &amp; &quot;zwarte pin(s) en &quot; &amp; wittepin &amp; &quot;wittepin(s)&quot;" newline="True"/>
                <if expression="zwartepin&gt;=4">
                    <then>
                        <assign variable="rij" expression="9"/>
                    </then>
                    <else/>
                </if>
            </for>
            <if expression="zwartepin&gt;=4">
                <then>
                    <output expression="&quot;Goed gedaan! Je hebt de code geraden. &quot; &amp; code" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Helaas, je hebt de code niet kunnen raden, de code was: &quot; &amp; code" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
