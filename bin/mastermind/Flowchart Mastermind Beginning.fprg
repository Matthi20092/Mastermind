    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="poging1, poging2, poging3, poging4" type="String" array="False" size=""/>
            <declare name="rij1" type="String" array="False" size=""/>
            <output expression="&quot;Rij 1, vakje 1&quot;" newline="True"/>
